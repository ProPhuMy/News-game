PORT=3000
# Enable only behind Render's managed public edge; direct hosts must leave false.
TRUST_RENDER_PROXY=false
# Optional exact immediate proxy IP; proxy must overwrite X-Real-IP and backend access must be private.
# Mutually exclusive with TRUST_RENDER_PROXY=true. Leave empty on direct hosts and Render.
TRUSTED_PROXY_ADDRESS=
AI_PROVIDER=none
# Set AI_MODEL and the selected provider key to enable AI.
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Outbound AI attempts across BOTH writing and rating. Zero disables outbound requests.
AI_REQUEST_ALLOWANCE=0
# Positive allowance requires a pre-created empty ledger on persistent host storage.
# Use an absolute path inside the container; never truncate/reset an existing ledger.
AI_ALLOWANCE_FILE=
# Full slots fall back immediately. One server process per ledger.
AI_MAX_CONCURRENT=4
